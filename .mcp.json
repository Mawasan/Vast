{
  "mcpServers": {
    "vast-agent": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR}/vast-agent/dist/index.js"],
      "env": {
        "VAST_AGENT_TRANSPORT": "stdio",
        "VAST_AGENT_DATA_DIR": "${CLAUDE_PROJECT_DIR}/vast-agent/data",
        "VAST_API_KEY": "${VAST_API_KEY:-}",
        "HF_TOKEN": "${HF_TOKEN:-}",
        "CIVITAI_API_TOKEN": "${CIVITAI_API_TOKEN:-}"
      }
    }
  }
}
