{
  "name": "vast-agent",
  "version": "0.1.0",
  "description": "Standalone MCP + HTTP agent for managing Vast.ai templates and instances, with Hugging Face and Civitai model search.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "VAST_AGENT_TRANSPORT=http node dist/index.js",
    "start:stdio": "VAST_AGENT_TRANSPORT=stdio node dist/index.js",
    "dev:http": "tsc -p tsconfig.json && VAST_AGENT_TRANSPORT=http node dist/index.js",
    "dev:stdio": "tsc -p tsconfig.json && VAST_AGENT_TRANSPORT=stdio node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
