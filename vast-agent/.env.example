# Required: Vast.ai API key (Account -> API Keys on console.vast.ai). Never commit this.
VAST_API_KEY=

# Optional: only needed for gated/private Hugging Face repos.
HF_TOKEN=

# Optional: only needed for NSFW-gated Civitai models or higher rate limits.
CIVITAI_API_TOKEN=

# Optional overrides (sensible defaults are used if unset):
# VAST_URL=https://console.vast.ai
# PORT=8080
# VAST_AGENT_TRANSPORT=http        # "http" (default, for Railway/remote MCP clients) or "stdio" (local MCP clients)
# VAST_AGENT_DATA_DIR=./data       # where the small local memory JSON file is stored
# VAST_AGENT_REQUIRE_CONFIRMATION=true  # require confirm:true for destroy/delete tools
